  expect(await pedirIA('chat', ENTRADA, ejemploChat)).toEqual({ datos: { fueraDeTema: false, respuesta: 'ok' }, ejemplo: false, local: true })
  respuestas({ respuesta: { fueraDeTema: false, respuesta: 'ok' } })
