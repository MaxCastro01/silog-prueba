import react from '@vitejs/plugin-react'
import tailwindcss from '@tailwindcss/vite'
import { defineConfig, loadEnv, type Plugin } from 'vite'

// npm run dev también sirve las funciones de api/ (cuenta, datos, ia) como lo hace Vercel.
// Lee las claves de .env.local; nunca llegan al navegador (no empiezan con VITE_).
function apiLocal(): Plugin {
  return {
    name: 'api-local',
    configureServer(server) {
      Object.assign(process.env, loadEnv(server.config.mode, process.cwd(), ['OPENROUTER_', 'ANTHROPIC_', 'OLLAMA_', 'DATABASE_', 'POSTGRES_']))
      server.middlewares.use(async (req, res, next) => {
        const url = new URL(req.url ?? '/', 'http://localhost')
        const nombre = url.pathname.match(/\/api\/(cuenta|datos|ia)$/)?.[1]
        if (!nombre) return next()
        try {
          const modulo = await server.ssrLoadModule(`/api/${nombre}.ts`)
          const f = modulo[req.method ?? 'GET']
          if (!f) { res.statusCode = 405; return res.end() }
          const partes: Buffer[] = []
          for await (const parte of req) partes.push(parte as Buffer)
          const headers = new Headers()
          for (const [k, v] of Object.entries(req.headers)) if (typeof v === 'string') headers.set(k, v)
          const r: Response = await f(new Request(`http://${req.headers.host}${req.url}`, {
            method: req.method, headers, body: partes.length ? Buffer.concat(partes) : undefined,
          }))
          res.statusCode = r.status
          r.headers.forEach((v, k) => { if (k !== 'set-cookie') res.setHeader(k, v) })
          const cookies = r.headers.getSetCookie()
          if (cookies.length) res.setHeader('Set-Cookie', cookies)
          res.end(Buffer.from(await r.arrayBuffer()))
        } catch (e) {
          next(e)
        }
      })
    },
  }
}

export default defineConfig({
  // Rutas relativas: funciona en la raíz o en una subcarpeta.
  base: './',
  plugins: [react(), tailwindcss(), apiLocal()],
})
</file>

<file path=".env.example">
# Copia este archivo como .env.local y pon tus claves ahí. NUNCA pongas claves en este archivo: este sí se sube a git.
# IA EXTERNA con clave: sirve OpenAI, Gemini, Groq, DeepSeek o cualquier API compatible con OpenAI.
# Pon la clave y el nombre del modelo (míralo en la documentación de tu proveedor).
IA_API_KEY=
IA_MODELO=
# Dirección de la API. Vacío = https://api.openai.com/v1. Otros proveedores (confírmala en su documentación):
#   Gemini   https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq     https://api.groq.com/openai/v1
#   DeepSeek https://api.deepseek.com
IA_API_URL=
# Modelo para leer la foto de la nota, si el de arriba no ve imágenes. Vacío = usa IA_MODELO.
IA_MODELO_VISION=
# Pon 1 para que la IA externa también lea el TEXTO de tu bitácora y las últimas preguntas del chat (igual que la IA local).
# Es lo que hace que el chat conteste sobre tus notas, pero entonces ese texto sale hacia tu proveedor de IA.
IA_REGISTROS_EN_NUBE=
# Para escoger quién contesta sin borrar variables: ollama, api, openrouter o anthropic. Vacío = el primero que esté configurado.
IA_PROVEEDOR=
# Solo si usas Anthropic directo: otro modelo (vacío = el que trae la app).
ANTHROPIC_MODEL=

# IA LOCAL (Ollama). Si pones OLLAMA_URL, la IA corre en tu computadora y se usa antes que OpenRouter o Anthropic.
# Instala Ollama (ollama.com), baja los modelos (ollama pull qwen3:8b) y deja Ollama prendido.
OLLAMA_URL=
# Modelo para texto (chat, plan, bitácora). Vacío = qwen3:8b.
OLLAMA_MODELO=
# Modelo con visión, para leer la foto de la nota. Vacío = qwen2.5vl:7b.
OLLAMA_MODELO_VISION=
# Solo si publicas la app (Vercel): la contraseña que exige tu túnel de ngrok (ver ollama.example.yaml). En tu computadora déjalo vacío.
OLLAMA_TOKEN=
# Opcionales: tamaño de contexto (8192 por defecto) y tiempo máximo de espera en milisegundos (50000 por defecto).
OLLAMA_CTX=
OLLAMA_TIMEOUT_MS=
# Pon 1 solo si quieres que, cuando Ollama falle, se use OpenRouter/Anthropic. Ojo: entonces los datos SÍ salen a la nube.
OLLAMA_RESPALDO=
OPENROUTER_API_KEY=
# Vacío = usa modelos gratuitos de OpenRouter. Para otros, escríbelos separados por comas (de openrouter.ai/models).
OPENROUTER_MODEL=
# Vacío = en tu computadora se usa PGlite (carpeta .datos/). En Vercel la pone sola la integración de Neon.
DATABASE_URL=
</file>

